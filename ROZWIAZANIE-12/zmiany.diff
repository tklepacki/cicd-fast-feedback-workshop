diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index ff416fe..52233c3 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -82,6 +82,13 @@ jobs:
       - run: npm ci
       - run: npm run test:unit
 
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: junit-unit
+          path: reports/unit.xml
+          retention-days: 1
+
   security:
     name: Security
     runs-on: ubuntu-latest
@@ -145,6 +152,15 @@ jobs:
           name: dist
           path: dist/
       - run: npm run test:api
+        env:
+          REPORT_NAME: api
+
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: junit-api
+          path: reports/api.xml
+          retention-days: 1
 
   test-ui:
     name: UI tests ${{ matrix.shard }}/${{ github.event_name == 'pull_request' && 2 || 8 }} (${{ github.event_name == 'pull_request' && 'smoke' || github.event_name == 'workflow_dispatch' && inputs.suite || 'full regression' }})
@@ -190,6 +206,7 @@ jobs:
       - name: UI tests
         run: npx playwright test --project=ui-chromium --shard=${{ matrix.shard }}/${{ github.event_name == 'pull_request' && 2 || 8 }} ${{ env.GREP }}
         env:
+          REPORT_NAME: ui-${{ matrix.shard }}
           GREP: >-
             ${{ (github.event_name == 'pull_request'
                  || (github.event_name == 'workflow_dispatch' && inputs.suite == 'smoke'))
@@ -205,6 +222,13 @@ jobs:
           path: blob-report/
           retention-days: 1
 
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: junit-ui-${{ matrix.shard }}
+          path: reports/ui-*.xml
+          retention-days: 1
+
   ui-report:
     name: UI report
     runs-on: ubuntu-latest
@@ -233,3 +257,39 @@ jobs:
           name: playwright-report
           path: playwright-report/
           retention-days: 7
+
+  test-report:
+    name: Test report
+    runs-on: ubuntu-latest
+    needs: [unit, test-api, test-ui]
+    if: always()
+    permissions:
+      contents: read
+      actions: read
+      checks: write
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version-file: .nvmrc
+
+      - name: Collect JUnit reports
+        uses: actions/download-artifact@v4
+        with:
+          pattern: junit-*
+          path: reports
+          merge-multiple: true
+
+      - name: Publish check run
+        uses: dorny/test-reporter@v3
+        if: always()
+        with:
+          name: Test results
+          path: reports/*.xml
+          reporter: java-junit
+          fail-on-error: true
+          use-actions-summary: false
+
+      - name: Job summary
+        if: always()
+        run: node scripts/ci-summary.mjs reports/*.xml
